# ---- Data files: never committed, real or synthetic ----
*.csv
*.tsv
*.parquet
*.xlsx
*.xls
*.duckdb
*.db
*.sqlite
*.sqlite3
*.feather
*.pkl
*.h5
*.dta
*.sav
data/**
!data/generators/
!data/generators/**
!data/README.md

# Tiny test fixtures are allowed through; the pre-commit hook enforces size (<=4KB)
# and location.
!tests/fixtures/*.csv

# ---- Run artefacts ----
runs/
outputs/
*.log

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.env
.env.*
!.env.example
.ipynb_checkpoints/

# ---- Tool caches ----
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.import_linter_cache/

# ---- Editors and OS ----
.DS_Store
.idea/
.vscode/

# The skill's wheel is a build product, produced by make-skill.sh; not committed.
skill/causpec-analyst/assets/*.whl
